# Ruflo local secrets and runtime data
.env
.env.local
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# Dependencies
node_modules/

# Ruflo memory / vector stores (local runtime state, not source)
.swarm/
ruvector.db
ruvector.db-*

# Claude Code local (machine-specific) settings
.claude/settings.local.json

# Python bytecode from the contract test harness
__pycache__/
*.pyc

# Toolchain install logs and binding-verification scratch (not source)
build/toolchain/*.log
build/verify/.work/

# Pinned third-party payloads a lane downloads at run time and verifies against
# a SHA-256 it carries (the Windows kill-switch lane's guest shell). Fetched,
# never committed: the digest is the provenance, not the checkout.
build/ci/.cache/

# Cargo build output (four workspaces: core, services, shells/linux, lab)
target/
**/target/

# Claude Code agent worktrees (transient; each has its own branch)
.claude/worktrees/
