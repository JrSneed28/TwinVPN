#!/usr/bin/env bash
# Run ruflo from the project's local install.
#
# Deliberately NOT `npx ruflo@<version>`: under npx the CLI runs out of the npx
# cache, so its bare `import('@claude-flow/aidefence')` resolves against that
# tree and never finds the project's copy - the aidefence_* MCP tools fail. The
# npx form also refetched on every launch, which blew the 30s MCP connect
# timeout. Everything here launches from ./node_modules for that reason.
#
# .ruflo-version remains the pin of record. package.json carries a caret range,
# so an `npm install` can float the installed copy off it; this checks rather
# than assumes. To upgrade, bump BOTH .ruflo-version and package.json.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
VERSION_FILE="$ROOT/.ruflo-version"
ENTRY="$ROOT/node_modules/ruflo/bin/ruflo.js"

if [[ ! -f "$VERSION_FILE" ]]; then
  echo "Missing $VERSION_FILE" >&2
  exit 1
fi
WANT="$(tr -d '[:space:]' < "$VERSION_FILE")"

if [[ ! -f "$ENTRY" ]]; then
  echo "ruflo is not installed at $ENTRY" >&2
  echo "Run: npm install" >&2
  exit 1
fi

HAVE="$(node -p "require('$ROOT/node_modules/ruflo/package.json').version")"
if [[ "$HAVE" != "$WANT" ]]; then
  echo "ruflo version drift: installed $HAVE, pinned $WANT (.ruflo-version)" >&2
  echo "Run 'npm install', or bump .ruflo-version and package.json together." >&2
  exit 1
fi

exec node "$ENTRY" "$@"
