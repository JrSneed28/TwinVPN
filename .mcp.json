{
  "mcpServers": {
    "claude-flow": {
      "command": "npx",
      "args": [
        "-y",
        "ruflo@latest",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "15",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "CLAUDE_FLOW_CONTEXT_WINDOW_TOKENS": "200000",
        "RUFLO_DAEMON_AUTOSTART": "1"
      },
      "autoStart": true
    },
    "ruv-swarm": {
      "command": "npx",
      "args": [
        "ruv-swarm",
        "mcp",
        "start",
        "--protocol=stdio"
      ],
      "capabilities": {
        "tools": true
      },
      "env": {
        "npm_config_update_notifier": "false"
      },
      "optional": true
    }
  }
}
