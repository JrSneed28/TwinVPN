{
  "mcpServers": {
    "claude-flow": {
      "command": "node",
      "args": [
        "./node_modules/ruflo/bin/ruflo.js",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false",
        "CLAUDE_FLOW_MODE": "v3",
        "CLAUDE_FLOW_HOOKS_ENABLED": "true",
        "CLAUDE_FLOW_TOPOLOGY": "hierarchical-mesh",
        "CLAUDE_FLOW_MAX_AGENTS": "10",
        "CLAUDE_FLOW_MEMORY_BACKEND": "hybrid",
        "CLAUDE_FLOW_MCP_TOOLS": "memory,swarm,agent,hooks,task,aidefence,hive-mind,guidance,federation,coordination,session",
        "CLAUDE_FLOW_CONTEXT_WINDOW_TOKENS": "200000"
      },
      "autoStart": false
    },
    "ruv-swarm": {
      "command": "node",
      "args": [
        "./node_modules/ruv-swarm/bin/ruv-swarm-secure.js",
        "mcp",
        "start"
      ],
      "env": {
        "npm_config_update_notifier": "false"
      },
      "optional": true
    }
  }
}
