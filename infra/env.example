# TwinVPN local development environment — EXAMPLE.
#
#     cp infra/env.example .env      # then EDIT it
#
# NOTE ON THE FILENAME. This is `env.example`, not `.env.example`. The tooling
# in this workspace refuses to write any path matching `.env*`, which is a
# guard against exactly the accident this file exists to prevent — a real
# credential file reaching the repository. The name is the only thing that
# differs; the content and the workflow are unchanged.
#
# ===========================================================================
# NOTHING IN THIS FILE IS A USABLE CREDENTIAL, AND THAT IS DELIBERATE.
# ===========================================================================
# Every value that is a secret is left as an obvious placeholder. Copying this
# file unedited produces a stack that REFUSES TO START with a readable error,
# because docker-compose.yml uses `${VAR:?message}` for each of them. That is
# the intended behaviour: a default password is a credential, and a credential
# in a repository is a credential that leaks.
#
# `.env` itself is never committed. Check before you commit; the repository
# .gitignore is the integration lead's file, not this domain's, so this file
# cannot enforce it for you.
#
# ===========================================================================
# READING THE TABLE IN infra/README.md
# ===========================================================================
# Every variable below appears in infra/README.md with its default, whether it
# is required, and WHAT HAPPENS WHEN IT IS ABSENT. Absence behaviour is stated
# there rather than implied here, because "it uses a sensible default" and "it
# fails to start" are very different facts and only one of them is safe.

# ---------------------------------------------------------------------------
# REQUIRED — no defaults exist for any of these.
# ---------------------------------------------------------------------------

# The Postgres superuser password. Choose one; do not use this text.
TWINVPN_PG_PASSWORD=CHANGE-ME-choose-a-real-value

# Connection URLs. They embed the password above, which is why they are here
# and not defaulted in the compose file.
#
# `sslmode=disable` is correct and honest for a single-host compose network and
# is WRONG anywhere else. The trust boundary here is the container network, not
# TLS; architecture.md §8 B3 is about device-to-infrastructure, and this link is
# infrastructure-internal.
TWINVPN_CP_DATABASE_URL=postgres://twinvpn:CHANGE-ME-choose-a-real-value@postgres:5432/twinvpn_control?sslmode=disable
TWINVPN_PRESENCE_DATABASE_URL=postgres://twinvpn:CHANGE-ME-choose-a-real-value@postgres:5432/twinvpn_presence?sslmode=disable
TWINVPN_RELAYDIR_DATABASE_URL=postgres://twinvpn:CHANGE-ME-choose-a-real-value@postgres:5432/twinvpn_relay_directory?sslmode=disable

# ---------------------------------------------------------------------------
# OPTIONAL — every one of these has a working default in docker-compose.yml.
# Uncomment only to change behaviour.
# ---------------------------------------------------------------------------

# --- environment and logging (ADR-0015 §11.5) ------------------------------
#TWINVPN_ENVIRONMENT=local
#TWINVPN_LOG_LEVEL=info
#TWINVPN_LOG_FORMAT=json
# DEBUG and TRACE auto-revert after this window so a verbose, SENSITIVE-bearing
# ledger cannot accumulate indefinitely. Raising it is a real privacy decision.
#TWINVPN_LOG_LEVEL_EXPIRY_MS=3600000

# --- address families (ADR-0010 R1) ----------------------------------------
# dual | ipv4 | ipv6. The compose overrides in infra/compose/ set this; setting
# it here as well would silently win over an override and hide which topology
# you are actually running.
#TWINVPN_ADDRESS_FAMILIES=dual
#TWINVPN_HAPPY_EYEBALLS_V6_BIAS_MS=250

# --- shutdown --------------------------------------------------------------
# ADR-0002 §11.7 rule 1: a planned restart is a DRAIN with a 120 s deadline,
# and each client picks its reattach instant uniformly from [0, deadline).
# The container `stop_grace_period` is 130 s so Docker does not SIGKILL a
# service in the middle of its own drain; raising this without raising that is
# a mistake the README calls out.
#TWINVPN_SHUTDOWN_GRACE_MS=120000
#TWINVPN_SHUTDOWN_DRAIN_DEADLINE_MS=120000

# --- observability ---------------------------------------------------------
#TWINVPN_OTEL_ENABLED=true
#OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
# 1.0 is correct for local development. ADR-0015 §6 notes that sampling means
# "the one failure you care about is often not recorded", which is fine in a
# lab and is a real cost in production.
#OTEL_TRACES_SAMPLER_ARG=1.0

# --- control plane (ADR-0002) ----------------------------------------------
#TWINVPN_CP_ATTACH_RATE_SUSTAINED=200
#TWINVPN_CP_ATTACH_RATE_BURST=1000
#TWINVPN_CP_DRAIN_DEADLINE_MS=120000
#TWINVPN_DB_MAX_CONNECTIONS=16
#TWINVPN_CP_EVENT_BUS=postgres-notify

# --- rendezvous (ADR-0002 §11.5) -------------------------------------------
#TWINVPN_RZ_CONTROL_PLANE_URL=https://control-plane:443

# --- relay fleet (ADR-0005, ADR-0006) --------------------------------------
#TWINVPN_RELAY_REGION=local-1
#TWINVPN_RELAY_OPERATOR_GROUP_ID=local-operator
#TWINVPN_RELAYDIR_MAP_TTL_MS=3600000

# --- relay health ----------------------------------------------------------
#TWINVPN_RELAYHEALTH_TARGETS=relay-a:9090,relay-b:9090
#TWINVPN_RELAYHEALTH_PROBE_INTERVAL_MS=10000

# --- build reproducibility (ADR-0018 BM-6) ---------------------------------
# SOURCE_DATE_EPOCH defaults to a fixed date rather than "now", so an
# unparameterised image build is still deterministic. Set it to the commit date
# for a build you intend to attest.
#SOURCE_DATE_EPOCH=1756252800
#TWINVPN_SOURCE_COMMIT=unknown

# --- base image pins (ADR-0018 §11.11 DP-2) --------------------------------
# Resolved digests from infra/docker/base-images.lock go here. Until they are
# resolved the tags below are used, and that gap is reported rather than hidden.
#TWINVPN_RUST_IMAGE=docker.io/library/rust:1.90.0-bookworm
#TWINVPN_RUNTIME_IMAGE=gcr.io/distroless/cc-debian12:nonroot
#TWINVPN_BUSYBOX_IMAGE=docker.io/library/busybox:1.37.0-musl
#TWINVPN_POSTGRES_IMAGE=docker.io/library/postgres:17.2-bookworm
#TWINVPN_OTELCOL_IMAGE=docker.io/otel/opentelemetry-collector-contrib:0.116.1
#TWINVPN_PROMETHEUS_IMAGE=docker.io/prom/prometheus:v3.1.0
#TWINVPN_TEMPO_IMAGE=docker.io/grafana/tempo:2.7.0
#TWINVPN_LOKI_IMAGE=docker.io/grafana/loki:3.3.2
#TWINVPN_GRAFANA_IMAGE=docker.io/grafana/grafana:11.4.0
