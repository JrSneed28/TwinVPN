{
  "claudeFlow": {
    "version": "3.0.0",
    "enabled": true,
    "orchestrator": {
      "timeout": 120000,
      "retryAttempts": 3,
      "retryDelay": 5000
    },
    "terminal": {
      "emulateEnvironment": true,
      "defaultShell": "/bin/bash",
      "workingDirectory": "./",
      "maxOutputLength": 10000,
      "timeout": 60000
    },
    "hooks": {
      "enabled": true,
      "learning": true
    },
    "platform": {
      "os": "linux",
      "arch": "x64",
      "shell": "/bin/bash"
    },
    "modelPreferences": {
      "default": "claude-opus-5",
      "routing": "claude-haiku-4-5-20251001"
    },
    "agentTeams": {
      "enabled": true,
      "teammateMode": "auto",
      "taskListEnabled": true,
      "mailboxEnabled": true,
      "coordination": {
        "mode": "hub-spoke",
        "maxRetries": 5,
        "retryDelay": 10000,
        "circuitBreaker": {
          "enabled": true,
          "threshold": 5,
          "timeout": 60000,
          "resetTimeout": 300000
        },
        "autoAssignOnIdle": true,
        "trainPatternsOnComplete": true,
        "notifyLeadOnComplete": true,
        "sharedMemoryNamespace": "agent-teams"
      },
      "loadBalancing": {
        "strategy": "round-robin",
        "healthCheckInterval": 30000,
        "maxLoad": 0.8
      },
      "hooks": {
        "teammateIdle": {
          "enabled": true,
          "autoAssign": true,
          "checkTaskList": true,
          "learning": true
        },
        "taskCompleted": {
          "enabled": true,
          "trainPatterns": true,
          "notifyLead": true
        }
      }
    },
    "swarm": {
      "topology": "hierarchical",
      "maxAgents": 15,
      "strategy": "specialized",
      "heartbeatInterval": 5000,
      "taskQueueSize": 100
    },
    "memory": {
      "type": "hybrid",
      "enableHNSW": true,
      "path": "./data",
      "maxEntries": 10000,
      "ttl": 86400,
      "hnsw": {
        "m": 16,
        "ef": 200,
        "efConstruction": 200
      },
      "encryption": {
        "enabled": false,
        "algorithm": "aes-256-gcm"
      },
      "learningBridge": {
        "enabled": true
      },
      "memoryGraph": {
        "enabled": true
      },
      "agentScopes": {
        "enabled": true
      }
    },
    "neural": {
      "enabled": true,
      "sona": true,
      "ewc": true,
      "moe": {
        "experts": 8,
        "topK": 2
      }
    },
    "logging": {
      "level": "info",
      "format": "json",
      "destination": "console",
      "filePath": "./logs/ruflo.log",
      "maxFileSize": "100MB",
      "maxFiles": 10
    },
    "monitoring": {
      "enabled": true,
      "metricsInterval": 60000,
      "alertThresholds": {
        "errorRate": 0.05,
        "responseTime": 5000,
        "memoryUsage": 0.9
      }
    },
    "daemon": {
      "autoStart": true,
      "workers": [
        "map",
        "audit",
        "optimize",
        "consolidate",
        "testgaps",
        "ultralearn",
        "deepdive",
        "document",
        "refactor",
        "benchmark"
      ],
      "schedules": {
        "audit": {
          "interval": "1h",
          "priority": "critical"
        },
        "optimize": {
          "interval": "30m",
          "priority": "high"
        },
        "consolidate": {
          "interval": "2h",
          "priority": "low"
        },
        "document": {
          "interval": "1h",
          "priority": "normal"
        },
        "deepdive": {
          "interval": "4h",
          "priority": "normal"
        },
        "ultralearn": {
          "interval": "1h",
          "priority": "normal"
        }
      }
    },
    "agents": {
      "source": ".claude/agents",
      "customAgents": []
    },
    "skills": {
      "source": ".claude/commands",
      "enabled": true
    },
    "learning": {
      "enabled": true,
      "autoTrain": true,
      "patterns": [
        "coordination",
        "optimization",
        "prediction"
      ],
      "retention": {
        "shortTerm": "24h",
        "longTerm": "30d"
      }
    },
    "adr": {
      "autoGenerate": true,
      "directory": "/docs/adr",
      "template": "madr"
    },
    "ddd": {
      "trackDomains": true,
      "validateBoundedContexts": true,
      "directory": "/docs/ddd"
    },
    "security": {
      "mode": "strict",
      "inputValidation": true,
      "pathValidation": true,
      "authentication": {
        "required": false,
        "method": "jwt"
      },
      "autoScan": true,
      "scanOnEdit": true,
      "cveCheck": true,
      "threatModel": true
    }
  }
}
