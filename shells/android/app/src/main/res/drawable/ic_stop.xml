<?xml version="1.0" encoding="utf-8"?>
<!--
  A notification small icon. Android renders these as a monochrome mask, so the
  shape is the ONLY signal the platform preserves — the tint is applied by the
  system. That is why `ServiceNotification` pairs every icon with the core's own
  sentence: ADR-0019's accessibility contract, and the plain fact that a user
  reading a monochrome shade gets no colour at all.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?android:attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M6,6h12v12H6z" />
</vector>
