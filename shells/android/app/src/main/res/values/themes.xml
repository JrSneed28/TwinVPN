<?xml version="1.0" encoding="utf-8"?>
<!--
  The Activity theme. Compose owns everything visible; this exists so the window
  has a background and a status-bar treatment before the first frame, which is
  what stops a white flash on a dark device.

  WHY THE BASE IS PLAIN `Theme.Material.NoActionBar`.

  Two platform DayNight names were tried against a real `aapt2` and neither
  exists:

      resource android:style/Theme.Material.DayNight.NoActionBar not found.
      resource android:style/Theme.DeviceDefault.DayNight.NoActionBar not found.

  `Theme.Material` has no DayNight family at all, and `Theme.DeviceDefault`'s
  DayNight member has no `NoActionBar` child. The remaining platform options
  are a DayNight base plus manual `windowActionBar`/`windowNoTitle` items, or
  an AppCompat dependency — and neither buys anything here, because **Compose
  owns light/dark**: this style is only ever visible for the frames before the
  first composition, and it sets its three colours from `?android:attr`
  references that already resolve per the device's configuration.

  So the DayNight base is dropped rather than guessed at a third time. If a
  pre-first-frame dark background is ever wanted on API 29+, the change is a
  `values-night/` override, which needs no new base style and no dependency.
-->
<resources>
    <style name="Theme.TwinVPN" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
    </style>
</resources>
